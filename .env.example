# Obrigatória — conta gratuita em https://openalex.org → Settings → API
OPENALEX_API_KEY=

# Recomendado — e-mail de contato (Crossref polite pool, NCBI, User-Agent)
CONTACT_EMAIL=

# Opcionais — deixar vazio se não tiver
# https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# https://www.semanticscholar.org/product/api (formulário)
S2_API_KEY=
# https://core.ac.uk/services/api
CORE_API_KEY=
# https://opencitations.net/accesstoken
OPENCITATIONS_TOKEN=

# Obrigatório ao expor a interface web fora de localhost (mínimo 32 caracteres aleatórios)
COLETOR_WEB_TOKEN=
